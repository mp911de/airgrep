(version 1)
(rule "Microphone clearance"
   (constraint clearance (min 0.1524mm))
   (constraint track_width (min 0.1524mm))
   (condition "A.Type != 'Zone' && A.intersectsCourtyard('MIC1')"))

(rule "IMU clearance"
   (constraint clearance (min 0.15mm))
   (condition "A.Type == 'Pad' && A.intersectsCourtyard('U2')"))