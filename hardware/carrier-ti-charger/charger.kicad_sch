		(uuid "0f9af413-f415-443c-a381-a60d62053576")
	)
	(text "1 A default charge, ESP32-S3 raises ICHG over I2C, watchdog (40 s) falls back. CE from the thermostat path (CHG_DIS high = charging off). TREG default 120 C."
		(exclude_from_sim no)
		(at 20.32 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "175606d8-6f7c-40e5-afec-bea6acf5cbf6")
	)
	(text "inside the charger's input current limit."
