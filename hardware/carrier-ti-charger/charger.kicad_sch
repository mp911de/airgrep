		(uuid "a52e5484-62f8-405a-9483-98f5a1d1e932")
	)
	(text "D+/D- BC1.2 on chip, CC has Rd only (USB input sheet). No ship FET: SDRV 1 nF, QON open. PROG 4.7k = 1S, 750 kHz. ILIM_HIZ 3.4 V = 3 A. TS 80.6k/768k: 3/43 C."
		(exclude_from_sim no)
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d7d4aa2f-eedd-47d2-988f-1ed8e31f4e8b")
	)
	(text "Q12: slider on = U14 off, no handover on unplug."
