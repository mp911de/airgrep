(footprint "Fiducial_1mm_Mask2mm"
	(version 20260206)
	(generator "kicad-footprint-generator")
	(layer "F.Cu")
	(descr "Fiducial, circular marking, 1mm bare copper, 2mm soldermask opening (Level A). Carrier copy of the KiCad library part: board-only (no schematic symbol), excluded from BOM and position files, reference hidden, 3 x 3 mm keepout for tracks, vias and copper pour so the opening shows only the dot.")
	(tags "fiducial")
	(property "Reference" "REF**"
		(at 0 -1.95 0)
		(layer "F.SilkS")
		(hide yes)
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(property "Value" "Fiducial_1mm_Mask2mm"
		(at 0 1.95 0)
		(layer "F.Fab")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(property "KiLib_Generator" "fiducial"
		(at 0 0 0)
		(layer "F.SilkS")
		(hide yes)
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(attr smd board_only exclude_from_pos_files exclude_from_bom)
	(duplicate_pad_numbers_are_jumpers no)
	(fp_circle
		(center 0 0)
		(end 1.25 0)
		(stroke
			(width 0.05)
			(type solid)
		)
		(fill no)
		(layer "F.CrtYd")
	)
	(fp_circle
		(center 0 0)
		(end 1 0)
		(stroke
			(width 0.1)
			(type solid)
		)
		(fill no)
		(layer "F.Fab")
	)
	(fp_text user "${REFERENCE}"
		(at 0 0 0)
		(layer "F.Fab")
		(effects
			(font
				(size 0.5 0.5)
				(thickness 0.08)
			)
		)
	)
	(pad "" smd circle
		(at 0 0)
		(size 1 1)
		(layers "F.Cu" "F.Mask")
		(solder_mask_margin 0.5)
		(clearance 0.6)
	)
	(zone
		(layers "F.Cu")
		(name "fiducial clear")
		(hatch edge 0.5)
		(connect_pads
			(clearance 0)
		)
		(min_thickness 0.25)
		(keepout
			(tracks not_allowed)
			(vias not_allowed)
			(pads allowed)
			(copperpour not_allowed)
			(footprints allowed)
		)
		(placement
			(enabled no)
			(sheetname "")
		)
		(fill
			(thermal_gap 0.5)
			(thermal_bridge_width 0.5)
		)
		(polygon
			(pts
				(xy -1.5 -1.5) (xy 1.5 -1.5) (xy 1.5 1.5) (xy -1.5 1.5)
			)
		)
	)
	(embedded_fonts no)
)
