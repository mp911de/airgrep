menu "airgrep loop"

    config AIRGREP_LOOP_TICK_MS
        int "Tick period in ms"
        default 50
        range 1 1000
        help
            Longest wait of the loop task for a new event. Timeouts and
            scheduled events are checked at least this often.

    config AIRGREP_LOOP_QUEUE_DEPTH
        int "Queue depth and number of promise slots"
        default 256
        range 8 4096

    config AIRGREP_LOOP_PRIORITY
        int "Loop task priority"
        default 5
        range 1 24

    config AIRGREP_LOOP_STACK
        int "Loop task stack in bytes"
        default 8192
        range 2048 65536

    config AIRGREP_LOOP_SCHEDULED
        int "Scheduled and periodic events held at once"
        default 32
        range 1 1024

endmenu
