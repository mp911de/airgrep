menu "airgrep hardware"

    choice AIRGREP_BOARD
        prompt "Controller module"
        default AIRGREP_BOARD_PLUS

        config AIRGREP_BOARD_PLUS
            bool "XIAO ESP32-S3 Plus"
    endchoice

    config AIRGREP_PIN_UART_RX
        int
        default 7 if AIRGREP_BOARD_PLUS

    config AIRGREP_PIN_UART_TX
        int
        default 44 if AIRGREP_BOARD_PLUS

    config AIRGREP_PIN_BUZZER
        int
        default 8 if AIRGREP_BOARD_PLUS

    config AIRGREP_PIN_USR_LED
        int
        default 21 if AIRGREP_BOARD_PLUS
        help
            Active-low user LED lit by the health check, -1 for none.

    config AIRGREP_CPU_METRICS
        bool "Measure the CPU load for the health check"
        default y
        select FREERTOS_GENERATE_RUN_TIME_STATS
        help
            Off leaves the CPU health bit at 0.

    config AIRGREP_PIN_SDA
        int
        default 5

    config AIRGREP_PIN_SCL
        int
        default 6

    config AIRGREP_I2C_TIMEOUT_MS
        int "I2C transaction timeout in ms"
        default 20
        range 1 1000
        help
            Longest wait for one transaction. Actions on the loop do one
            transaction each, so this bounds the action.

endmenu
