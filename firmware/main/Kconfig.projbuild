menu "airgrep"
	config AIRGREP_USB_SERVICE_COMMANDS
		bool "USB State access and data injection commands"
		default n
		help
			Enables READ, WRITE, UPDATE_TRAFFIC, UPDATE_GNSS, LIST_TRAFFIC,
			READ_SETTINGS and WRITE_SETTINGS over USB.
			WRITE can replace arbitrary bytes within exposed component States.
			WRITE_SETTINGS replaces and removes the stored settings.
			HELLO, REBOOT and ENTER_BOOTLOADER remain available when disabled.

	config AIRGREP_TEST_TAGS
		string "Unity tags to run at boot, space separated"
		default "[adsbee] [loop] [logs] [expander] [charger] [battery] [barometer] [fusb] [buzzer]"
		help
			Tests with these tags run after boot in the test build, then the
			Unity menu opens. Empty runs nothing and opens the menu directly.

	config AIRGREP_HWTEST
		bool "Hardware test mode"
		default n
		help
			Boots the normal loop, then runs the hardware checks and prints
			one "HWTEST <name> PASS|FAIL <detail>" line per check.

	config AIRGREP_FPS_OVERLAY
		bool "Show live display statistics"
		default n

	config AIRGREP_PROFILER
		bool "LVGL draw profiler"
		default y if AIRGREP_HWTEST
		help
			Hooks the LVGL draw calls for the render_profile hardware check.
			It costs time on every draw, so release builds leave it out.

	config AIRGREP_DISPLAY
		string "Display variant"
		default ""
		help
			Directory in components/display/variants, set by the sdkconfig
			fragment in that directory. Empty builds no display and no LVGL.
			Defined here because the LVGL dependency is resolved from it in
			every build, also in those without the display component.

endmenu
