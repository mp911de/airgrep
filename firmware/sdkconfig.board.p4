CONFIG_IDF_TARGET="esp32p4"
CONFIG_AIRGREP_BOARD_P4_NANO=y
# ESP32-P4NRW32X is production rev 3.x.
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_CACHE_L2_CACHE_512KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_LV_USE_PPA=y
CONFIG_LV_USE_PPA_IMG=y
# PPA cache maintenance requires cache-line-aligned framebuffers.
CONFIG_LV_DRAW_BUF_ALIGN=128
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_AIRGREP_USB_SERVICE_COMMANDS=y
# The P4 loop serves USB and traffic timers. Display rendering has its own task.
CONFIG_AIRGREP_LOOP_QUEUE_DEPTH=32
CONFIG_AIRGREP_LOOP_STACK=12288
