# LVGL Pro exports immutable A8 masks but omits their static_bitmap flag.
# Only the upright software draw callback can also omit preparing a scratch buffer.
function(airgrep_glyph_source source output)
    set(tool "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/lvgl-glyphs.py")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}" "${tool}")
    execute_process(COMMAND python3 "${tool}" "${source}" "${output}" COMMAND_ERROR_IS_FATAL ANY)
endfunction()

function(airgrep_lvgl_glyphs target lvgl_dir)
    get_target_property(sources ${target} SOURCES)
    foreach(path IN ITEMS src/draw/lv_draw_label.c src/draw/sw/lv_draw_sw_letter.c)
        set(source "${lvgl_dir}/${path}")
        if(NOT source IN_LIST sources)
            message(FATAL_ERROR "LVGL no longer builds ${source}")
        endif()
        set(output "${CMAKE_CURRENT_BINARY_DIR}/generated/lvgl/${path}")
        airgrep_glyph_source("${source}" "${output}")
        get_filename_component(include_dir "${source}" DIRECTORY)
        set_source_files_properties("${output}" TARGET_DIRECTORY ${target} PROPERTIES INCLUDE_DIRECTORIES "${include_dir}")
        list(REMOVE_ITEM sources "${source}")
        list(APPEND sources "${output}")
    endforeach()
    set_property(TARGET ${target} PROPERTY SOURCES "${sources}")
endfunction()
