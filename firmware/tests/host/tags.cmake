# Fails when a tag of CONFIG_AIRGREP_TEST_TAGS in sdkconfig.test is carried by no TEST_CASE.
file(STRINGS "${FIRMWARE}/sdkconfig.test" setting REGEX "^CONFIG_AIRGREP_TEST_TAGS=\"")
string(REGEX REPLACE "^CONFIG_AIRGREP_TEST_TAGS=\"(.*)\"$" "\\1" tags "${setting}")
separate_arguments(tags)
if (NOT tags)
    message(FATAL_ERROR "sdkconfig.test names no boot test tags")
endif ()
file(GLOB tests "${FIRMWARE}/components/*/test/*" "${FIRMWARE}/main/test/*")
set(text "")
foreach (test ${tests})
    if (NOT IS_DIRECTORY "${test}")
        file(READ "${test}" part)
        string(APPEND text "${part}")
    endif ()
endforeach ()
set(missing "")
foreach (tag ${tags})
    string(FIND "${text}" "\"${tag}\"" at)
    if (at EQUAL -1)
        string(APPEND missing " ${tag}")
    endif ()
endforeach ()
if (missing)
    message(FATAL_ERROR "No TEST_CASE carries:${missing}")
endif ()
